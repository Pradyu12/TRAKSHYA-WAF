[Unit]
Description=TRAKSHYA WAF Management API (DuckDB)
Documentation=https://github.com/Pradyu12/TRAKSHYA-WAF
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/trakshya-waf
EnvironmentFile=/opt/trakshya-waf/.env
Environment=TRAKSHYA_MGMT_PORT=8000
Environment=TRAKSHYA_DUCKDB_PATH=/opt/trakshya-waf/data/trakshya_events.duckdb
Environment=TRAKSHYA_FRONTEND_DIR=/opt/trakshya-waf/frontend
ExecStart=/opt/trakshya-waf/build/trakshya-api
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
