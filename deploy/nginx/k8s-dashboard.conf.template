server {
  listen 8000;
  listen [::]:8000;
  server_name _;

  root /usr/share/nginx/html;
  index dashboard.html;

  # Live management API (DuckDB-backed) — never fall back to mock data
  location /api/ {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $$host;
    proxy_set_header X-Real-IP $$remote_addr;
    proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $$scheme;
    proxy_buffering off;
    proxy_read_timeout 3600s;
  }

  location /health {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/health;
  }

  location /healthz {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/healthz;
  }

  location /ready {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/ready;
  }

  location /api/ws {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/api/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $$http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $$host;
    proxy_read_timeout 3600s;
  }

  location /api/stream {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/api/stream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 3600s;
  }

  location /api/logs/stream {
    proxy_pass http://${TRAKSHYA_API_UPSTREAM}/api/logs/stream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 3600s;
  }

  location / {
    try_files $$uri $$uri/ /dashboard.html;
  }
}
